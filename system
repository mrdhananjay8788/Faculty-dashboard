    <!-- SYNCHRONIZED PURE WHITE/SILVER COMET ENGINE -->
    <script>
        const canvas = document.getElementById('silverCometCanvas');
        const ctx = canvas.getContext('2d');

        let stars = [];
        const numStars = 240; 
        const mouse = { x: null, y: null, radius: 180 };

        function resize() {
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
        }
        window.addEventListener('resize', resize);
        resize();

        window.addEventListener('mousemove', (e) => {
            mouse.x = e.clientX;
            mouse.y = e.clientY;
        });
        window.addEventListener('mouseleave', () => {
            mouse.x = null;
            mouse.y = null;
        });

        class StarComet {
            constructor() {
                this.distance = Math.random() * (Math.max(canvas.width, canvas.height) * 0.55) + 20;
                this.angle = Math.random() * Math.PI * 2;
                this.spiralFactor = this.distance * 0.003; 
                this.speed = (Math.random() * 0.0004) + 0.0001; 
                this.size = Math.random() * 1.3 + 0.4;
                this.alpha = Math.random() * 0.4 + 0.15;
            }

            draw(x, y) {
                ctx.fillStyle = 'rgba(255, 255, 255, ' + this.alpha + ')';
                ctx.beginPath();
                ctx.arc(x, y, this.size, 0, Math.PI * 2);
                ctx.fill();
            }

            update() {
                this.angle += this.speed;

                let centerX = canvas.width / 2;
                let centerY = canvas.height / 2;
                
                let currentX = centerX + Math.cos(this.angle + this.spiralFactor) * this.distance;
                let currentY = centerY + Math.sin(this.angle + this.spiralFactor) * this.distance;

                if (mouse.x !== null && mouse.y !== null) {
                    let dx = mouse.x - currentX;
                    let dy = mouse.y - currentY;
                    let dist = Math.sqrt(dx * dx + dy * dy);

                    if (dist < mouse.radius) {
                        let force = (mouse.radius - dist) / mouse.radius;
                        currentX += (dx / dist) * force * 14;
                        currentY += (dy / dist) * force * 14;
                    }
                }

                if(currentX > 320) {
                    this.draw(currentX, currentY);
                }
            }
        }

        function init() {
            stars = [];
            for (let i = 0; i < numStars; i++) {
                stars.push(new StarComet());
            }
        }

        function loop() {
            ctx.fillStyle = 'rgba(1, 1, 3, 0.1)';
            ctx.fillRect(0, 0, canvas.width, canvas.height);

            for (let i = 0; i < stars.length; i++) {
                stars[i].update();
            }
            requestAnimationFrame(loop);
        }

        init();
        loop();
    </script>
