// SAFE AUTO-CREATE & COLUMN PATCH (Prevents uncaught mysqli_sql_exception)
function ensureActivityTableStructure($conn) {
    // 1. Ensure `activities` table exists first
    $createTableSQL = "CREATE TABLE IF NOT EXISTS `activities` (
        `activity_id` INT AUTO_INCREMENT PRIMARY KEY,
        `subject` VARCHAR(150) NOT NULL,
        `unit` VARCHAR(50) NOT NULL,
        `title` VARCHAR(255) NOT NULL,
        `description` TEXT,
        `due_date` DATE NOT NULL,
        `max_marks` TINYINT NOT NULL DEFAULT 5,
        `created_by` INT DEFAULT NULL,
        `attachment` VARCHAR(255) DEFAULT NULL,
        `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP
    ) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4";
    
    try {
        @mysqli_query($conn, $createTableSQL);
    } catch (Exception $e) {
        // Table creation handled silently
    }

    // 2. Check and add `attachment` column if missing
    try {
        $checkCol = @mysqli_query($conn, "SHOW COLUMNS FROM `activities` LIKE 'attachment'");
        if ($checkCol && mysqli_num_rows($checkCol) === 0) {
            @mysqli_query($conn, "ALTER TABLE `activities` ADD COLUMN `attachment` VARCHAR(255) DEFAULT NULL");
        }
    } catch (Exception $e) {
        // Column check handled silently
    }
}

// Run schema verification before executing any form processing
ensureActivityTableStructure($conn);

if ($_SERVER["REQUEST_METHOD"] === "POST") {
    $subject     = trim($_POST['subject']);
    $unit        = trim($_POST['unit']);
    $title       = trim($_POST['activity_title']);
    $description = trim($_POST['activity_description']);
    $due_date    = trim($_POST['due_date']);
    $max_marks   = trim($_POST['max_marks']);
    $created_by  = $_SESSION['user_id'];
    $attachment_path = NULL;

    // Handle File Attachment Uploads (PDF / JPG / JPEG / PNG)
    if (isset($_FILES['activity_media']) && $_FILES['activity_media']['error'] === UPLOAD_ERR_OK) {
        $fileTmpPath = $_FILES['activity_media']['tmp_name'];
        $fileName    = $_FILES['activity_media']['name'];
        $fileSize    = $_FILES['activity_media']['size'];
        
        $fileNameCmps = explode(".", $fileName);
        $fileExtension = strtolower(end($fileNameCmps));

        $allowedExtensions = ['pdf', 'jpeg', 'jpg', 'png'];

        if (in_array($fileExtension, $allowedExtensions)) {
            // Max file size limit: 10MB
            if ($fileSize <= 10 * 1024 * 1024) {
                $uploadFileDir = './uploads/';
                
                if (!is_dir($uploadFileDir)) {
                    mkdir($uploadFileDir, 0755, true);
                }

                $newFileName = md5(time() . $fileName) . '.' . $fileExtension;
                $dest_path = $uploadFileDir . $newFileName;

                if (move_uploaded_file($fileTmpPath, $dest_path)) {
                    $attachment_path = $dest_path;
                } else {
                    $status_message = "File upload error: Failed to store file in server storage.";
                    $status_type = "danger";
                }
            } else {
                $status_message = "File upload blocked: File exceeds maximum 10MB size limit.";
                $status_type = "danger";
            }
        } else {
            $status_message = "Invalid file type: Only PDF, JPEG, JPG, and PNG files are allowed.";
            $status_type = "danger";
        }
    }

    if (empty($status_message)) {
        if (!empty($subject) && !empty($unit) && !empty($title) && !empty($due_date) && !empty($max_marks)) {
            $stmt = $conn->prepare("INSERT INTO activities (subject, unit, title, description, due_date, max_marks, created_by, attachment) VALUES (?, ?, ?, ?, ?, ?, ?, ?)");
            
            if ($stmt) {
                $stmt->bind_param("sssssdis", $subject, $unit, $title, $description, $due_date, $max_marks, $created_by, $attachment_path);
                if ($stmt->execute()) {
                    $status_message = "Activity and attached media successfully deployed to terminal logs.";
                    $status_type = "success";
                } else {
                    $status_message = "Database writing fault: Session state update aborted.";
                    $status_type = "danger";
                }
                $stmt->close();
            } else {
                $status_message = "Internal processing pipeline failure: Prepared statement configuration error.";
                $status_type = "danger";
            }
        } else {
            $status_message = "Validation aborted: Required allocation boundaries are missing.";
            $status_type = "danger";
        }
    }
}
